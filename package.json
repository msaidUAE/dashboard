{
  "name": "kpis-analysis-dashboard",
  "version": "2.0.0",
  "description": "Professional KPI Analysis Dashboard for company LAN deployment",
  "private": true,
  "keywords": [
    "kpi",
    "dashboard",
    "analytics",
    "data-visualization",
    "react",
    "typescript"
  ],
  "author": "Professional Development Team",
  "license": "Proprietary",
  "dependencies": {
    "axios": "^1.6.5",
    "chart.js": "^4.4.1",
    "date-fns": "^2.30.0",
    "lodash": "^4.17.21",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.1",
    "ajv": "^8.20.0",
    "cross-env": "^7.0.3",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "vite": "^5.1.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "cross-env VITE_BASE_PATH=/dashboard/ npm run build",
    "serve:lan": "node scripts/serve-dashboard.js",
    "deploy:lan": "npm run build && npm run serve:lan",
    "test:lan-server": "node --test scripts/serve-dashboard.test.js",
    "preview": "vite preview",
    "test": "react-scripts test --watchAll=false --runInBand",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
